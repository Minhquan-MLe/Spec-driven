# Copy this file to .env and adjust values if you need to (e.g. a
# different POSTGRES_PORT if 5432 is already taken on your machine).
#
# .env is gitignored — never commit real credentials. The values below
# are safe placeholders for local development only, not production
# secrets.

POSTGRES_USER=agentclinic
POSTGRES_PASSWORD=changeme_local_dev
POSTGRES_DB=agentclinic
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Used directly by the migration/seed scripts (and, in a later phase, by
# the running app) to connect to Postgres. Keep this in sync with the
# POSTGRES_* values above.
DATABASE_URL=postgresql://agentclinic:changeme_local_dev@localhost:5432/agentclinic

# A separate database on the SAME Postgres server/container, used only
# by automated tests (see `npm run db:test:create` / `db:test:migrate`
# in README.md). Never used by `npm start`. Same host/port/credentials
# as DATABASE_URL above — only the database name differs.
TEST_DATABASE_URL=postgresql://agentclinic:changeme_local_dev@localhost:5432/agentclinic_test
